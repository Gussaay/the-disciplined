{
  "appId": "com.the.disciplined",
  "appName": "الملتزم",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#0F3D3E",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0F3D3E"
    },
    "LocalNotifications": {
      "iconColor": "#0F3D3E"
    },
    "SocialLogin": {
      "google": true,
      "facebook": false,
      "apple": false,
      "twitter": false
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true
    }
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "force"
  }
}
