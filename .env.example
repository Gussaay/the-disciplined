# Everything here is optional. With no values the app works fully on the device
# (no account, no cloud). Fill these in to turn on accounts and cloud backup.
# Firebase console > Project settings > Your apps > Web app > SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Region of the Cloud Function that answers AI requests (functions/ai.js).
VITE_FUNCTIONS_REGION=us-central1
